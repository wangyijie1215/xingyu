<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 桌宠：悬浮在其他应用上层 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 桌宠前台服务（Android 9+ 必需，否则服务会被系统回收） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 语音输入：按住说话 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 语音识别服务查询（Android 11+ 需要声明，否则查不到系统识别服务）-->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!--
      本地 Ollama 走 http 明文。Android 9+ 默认禁止明文流量，因此必须显式放行。
      这里只放行本地/局域网地址，不开放任意明文。
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.EchoFlow">

        <!-- 开屏：应用入口 -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.EchoFlow.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".CardListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CardEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CardChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CharacterProfileActivity"
            android:exported="false" />

        <!-- 神社 · 每日运势（扩展） -->
        <activity
            android:name=".ShrineActivity"
            android:exported="false" />

        <activity
            android:name=".OmikujiActivity"
            android:exported="false" />

        <activity
            android:name=".FortuneActivity"
            android:exported="false" />

        <activity
            android:name=".EmaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 她的日记 / 信笺 / 时间胶囊（扩展） -->
        <activity
            android:name=".DiaryActivity"
            android:exported="false" />

        <activity
            android:name=".LettersActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CapsuleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 手机模式（微信风） -->
        <activity
            android:name=".PhoneListActivity"
            android:exported="false" />

        <activity
            android:name=".PhoneChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PhoneHomeActivity"
            android:exported="false" />

        <activity
            android:name=".PhoneMomentsActivity"
            android:exported="false" />

        <activity
            android:name=".PhoneScheduleActivity"
            android:exported="false" />

        <activity
            android:name=".PhoneDialerActivity"
            android:exported="false" />

        <activity
            android:name=".VoiceCallActivity"
            android:exported="false" />

        <activity
            android:name=".TtsSettingsActivity"
            android:exported="false"
            android:label="语音设置" />

        <activity
            android:name=".PhoneAppActivity"
            android:exported="false" />

        <activity
            android:name=".LorebookActivity"
            android:exported="false" />

        <activity
            android:name=".ImageGenActivity"
            android:exported="false" />

        <activity
            android:name=".GeneralAssistantActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PetSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".BottleActivity"
            android:exported="false" />

        <activity
            android:name=".DocActivity"
            android:exported="false" />


        <!-- 桌宠：前台服务 -->
        <service
            android:name=".PetService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="desktop_pet_overlay" />
        </service>
    </application>

</manifest>
