<?xml version="1.0" encoding="utf-8"?>
<!--
  明文流量策略：只对本地 / 局域网地址放行 http，公网仍强制 https。

  为什么必须配：本地 Ollama 默认不启 TLS，走 http，
  而 Android 9+ 默认禁止一切明文流量 —— 不配这个文件连接会直接失败。

  为什么 base-config 也放开明文：手机连电脑上的 Ollama 时是局域网 IP
  （192.168.x.x / 10.x.x.x / 172.16~31.x.x），没法逐个列举域名。
  公网地址仍然受 base-config 的信任锚约束（只有系统证书链才被接受），
  所以不会把明文流量扩散到外网服务上。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- 局域网：允许明文，因为 Ollama 通常是 http -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
