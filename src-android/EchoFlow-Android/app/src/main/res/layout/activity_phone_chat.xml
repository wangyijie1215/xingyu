<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDEDED"
    android:orientation="vertical">

    <!-- 系统状态栏（真实时间/电量） -->
    <include layout="@layout/view_phone_statusbar" />

    <!-- 微信风顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/wx_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/wx_back"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="‹"
            android:textColor="#181818"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wx_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="聊天"
                android:textColor="#181818"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wx_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#07C160"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/wx_more"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="···"
            android:textColor="#181818"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- 消息区 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wx_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#EDEDED"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <!-- 输入栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/wx_input_bar"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/wx_voice"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🎙"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/wx_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/wx_input_box"
            android:hint="发消息…"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minHeight="40dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#B2B2B2"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/wx_send"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/wx_bubble_right"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingHorizontal="14dp"
            android:text="发送"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
