<?xml version="1.0" encoding="utf-8"?>
<!--
  首页：以「角色」为中心，而不是以「聊天记录」为中心。

  信息架构：
    顶栏（标题 + 今日状态 + ⋯ 溢出菜单）
    ├ 今日一句（她今天的状态，来自日程/情绪）
    ├ 继续对话（最近聊过的角色，横滑）
    └ 最近动态（朋友圈摘要，来自手机里的朋友圈）
    底部（快速输入 → 进当前角色聊天）

  与旧版的差别：
    旧版是一个空的聊天框 + 一排按钮，用户进来不知道点哪；
    新版直接给出「和谁继续」「发生了什么」，把入口藏在 ⋯ 里。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <!-- ============ 顶栏 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ef_bg_profile_hero"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#33000000"
                    android:shadowRadius="4"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/app_slogan"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_phone_mode"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/ef_chip_accent"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="📱 手机"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_more"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ef_chip_ghost"
                android:gravity="center"
                android:text="⋯"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ 今日一句 ============ -->
    <LinearLayout
        android:id="@+id/today_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/ef_bg_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今天"
                android:textColor="@color/ef_primary_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/today_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/ef_text_3"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/today_who"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/ef_text_1"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/today_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/ef_text_2"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ============ 继续对话 ============ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:text="继续对话"
        android:textColor="@color/ef_text_2"
        android:textSize="13sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/char_strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp" />
    </HorizontalScrollView>

    <!-- ============ 最近动态 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="最近动态"
            android:textColor="@color/ef_text_2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_open_moments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="在手机里看 ›"
            android:textColor="@color/ef_primary_light"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/moments_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <!-- 动态空态 -->
    <TextView
        android:id="@+id/moments_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingHorizontal="40dp"
        android:text="还没有动态。\n进手机里的「朋友圈」，点一下就能让角色们发今天的动态。"
        android:textColor="@color/ef_text_3"
        android:textSize="13sp"
        android:lineSpacingExtra="5dp"
        android:visibility="gone" />

    <!-- ============ 底部快速入口 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/btn_quick_chat"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/ef_bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="说点什么…"
                android:textColor="@color/ef_text_3"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/ef_bg_send"
            android:gravity="center"
            android:minWidth="76dp"
            android:paddingHorizontal="18dp"
            android:text="发送"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_cards"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/ef_bg_send"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="开始对话"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 隐藏的输入：保持与旧逻辑兼容（点快速入口时弹出） -->
    <EditText
        android:id="@+id/input"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:imeOptions="actionSend"
        android:inputType="textMultiLine"
        android:maxLines="5" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_list"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/welcome"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</LinearLayout>
