<?xml version="1.0" encoding="utf-8"?>
<!-- 通话界面：实时语音（转录走聊天模型） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B14">

    <ImageView
        android:id="@+id/vc_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/ef_shrine_hero" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0B0B14" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/vc_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在呼叫…"
            android:textColor="#ABA6C6"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/vc_avatar"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_marginTop="34dp"
            android:background="#22FFFFFF"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/app_icon" />

        <TextView
            android:id="@+id/vc_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#F4F2FF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vc_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#E8C87A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/vc_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFeatureSettings="tnum"
            android:text="00:00"
            android:textColor="#F4F2FF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- 她的实时字幕 -->
        <TextView
            android:id="@+id/vc_caption"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="22dp"
            android:layout_weight="1"
            android:background="@drawable/ef_bg_glass"
            android:lineSpacingExtra="5dp"
            android:padding="14dp"
            android:text=""
            android:textColor="#F4F2FF"
            android:textSize="14sp"
            android:visibility="gone" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 转录记录按钮 -->
        <TextView
            android:id="@+id/vc_transcript"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/ef_bg_glass"
            android:gravity="center"
            android:text="说点什么，她会回你"
            android:textColor="#ABA6C6"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vc_mute"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/ef_bg_glass"
                android:gravity="center"
                android:text="🔇"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/vc_speaker"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/ef_bg_glass"
                android:gravity="center"
                android:text="🔊"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/vc_hangup"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/phone_call_btn"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="静音 · 免提 · 挂断"
            android:textColor="#6F6A8B"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
