<?xml version="1.0" encoding="utf-8"?>
<!-- 微信风消息行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp">

    <TextView
        android:id="@+id/wx_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:textColor="#B2B2B2"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <!-- 对方头像 -->
        <ImageView
            android:id="@+id/wx_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/app_icon" />

        <!-- 左侧弹簧 -->
        <View
            android:id="@+id/wx_left_space"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- 气泡 -->
        <LinearLayout
            android:id="@+id/wx_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/wx_bubble_left"
            android:maxWidth="264dp"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp">

            <TextView
                android:id="@+id/wx_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textColor="#1A1A1A"
                android:textIsSelectable="true"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 自己头像（保留占位，便于以后加） -->
        <ImageView
            android:id="@+id/wx_avatar_right"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- 右侧弹簧 -->
        <View
            android:id="@+id/wx_right_space"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
