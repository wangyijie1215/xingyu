<?xml version="1.0" encoding="utf-8"?>
<!-- 首页角色卡：头像 + 名字 + 此刻状态 + 亲密度 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="112dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/ef_bg_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="14dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp">

        <ImageView
            android:id="@+id/hc_avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/app_icon" />

        <View
            android:id="@+id/hc_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/ef_online_dot" />
    </FrameLayout>

    <TextView
        android:id="@+id/hc_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/ef_text_1"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hc_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/ef_text_3"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/hc_unread"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/ef_badge"
        android:gravity="center"
        android:minWidth="18dp"
        android:paddingHorizontal="6dp"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
