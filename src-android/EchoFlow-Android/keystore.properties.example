# ── 签名凭证（模板）───────────────────────────────
#
# 复制这个文件为 keystore.properties，填入自己的值。
#
# keystore.properties 已被 .gitignore 排除，不会被提交。
#
# 生成自己的密钥库：
#   keytool -genkeypair -v -keystore echoflow-release.jks \
#     -alias echoflow -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass <你的密码> -keypass <你的密码>
#
# 注意：换密钥库会导致已安装的版本无法覆盖升级
# （Android 要求同一个包名的签名一致）。

storeFile=../echoflow-release.jks
storePassword=CHANGE_ME
keyAlias=echoflow
keyPassword=CHANGE_ME
